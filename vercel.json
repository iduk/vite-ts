{
    "rewrites": [{ "source": "/(.*)", "destination": "/" }],
    "headers": [
        {
            "source": "/mockServiceWorker.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store"
                },
                {
                    "key": "Content-Type",
                    "value": "application/javascript"
                }
            ]
        }
    ]
}
